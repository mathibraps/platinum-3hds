<?xml version="1.0" encoding="utf-8"?>
<!-- The Android builder: picks a ROM, runs the builder program (packaged as
     a native library, lib/<abi>/libplatinum3hds.so, so it may be run) and
     saves the game files where the user chooses. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.mathibraps.platinum3hds"
    android:versionCode="1"
    android:versionName="0.0.1-beta">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <application
        android:label="Platinum 3HDS Builder"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for a ROM from a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
