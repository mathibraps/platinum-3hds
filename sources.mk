# Shared between Makefile (3DS) and Makefile.host (desktop test build).

DECOMP ?= ../decomp
# NitroSDK and NitroSystem reconstructions (github.com/ntrtwl), at the
# revisions the decomp pins in its subprojects/*.wrap.
NITROSDK ?= ../NitroSDK
NITROSYSTEM ?= ../NitroSystem
# Headers generated by the decomp's own build (tools/setup_decomp_gen.sh).
DECOMP_GEN ?= ../decomp-gen

# Decomp sources: everything the decomp's own build compiles (its generated
# src/meson.build, see tools/setup_decomp_gen.sh), minus the files the port
# replaces (PORT_SRCS below), unmodified except for patches/.
PORT_REPLACED := heap.c game_overlay.c boot.c nintendo_wfc/voice_chat.c
GAME_SRCS := $(filter-out $(PORT_REPLACED),$(shell grep -oE "'[^']+\.c'" $(DECOMP)/src/meson.build | tr -d "'"))

# Decomp libraries: particle system, GDS (online data), crypto (C parts).
LIB_SRCS := $(patsubst $(DECOMP)/lib/%,%,$(wildcard $(DECOMP)/lib/spl/src/*.c $(DECOMP)/lib/gds/src/*.c $(DECOMP)/lib/crypto/src/*.c))

# The SDK sound library has two halves, as on the DS: the interface the game
# calls (SND_SRCS, ARM9) and the driver that ran on the ARM7 (SND7_SRCS:
# sequencer, envelopes, channel allocation), which the port runs beside the
# game (platform/src/ntr_snd.c). The driver is compiled a second time from
# the same sources with SDK_ARM7 and its symbols renamed (ntr_snd7.h).
SND_SRCS := snd/src/snd_interface.c snd/src/snd_main.c snd/src/snd_command.c snd/src/snd_alarm.c \
	snd/src/snd_work.c snd/src/snd_util.c snd/src/snd_bank.c snd/src/snd_data.c
SND7_SRCS := snd/src/ARM7/snd_global.c snd/src/ARM7/snd_channel.c snd/src/ARM7/snd_capture.c \
	snd/src/ARM7/snd_exchannel.c snd/src/ARM7/snd_seq.c snd/src/ARM7/snd_midiplayer.c \
	$(filter-out snd/src/snd_interface.c,$(SND_SRCS))
# NitroSDK library sources that are plain computation (no hardware access)
# and are built as-is, minus their Metrowerks assembly routines.
SDK_SRCS := \
	fx/src/fx.c fx/src/fx_atan.c fx/src/fx_atanidx.c fx/src/fx_asinacosidx.c fx/src/fx_cp.c \
	fx/src/fx_mtx22.c fx/src/fx_mtx33.c fx/src/fx_mtx43.c fx/src/fx_mtx44.c fx/src/fx_sincos.c \
	fx/src/fx_trig.c fx/src/fx_vec.c \
	math/src/checksum.c math/src/crc.c math/src/dgt.c math/src/fft.c math/src/math.c math/src/qsort.c \
	gx/src/g3.c gx/src/g3b.c gx/src/g3_util.c rtc/src/convert.c $(SND_SRCS)
# SDK sources include their library's private headers by relative path.
SDK_PRIVATE_INCLUDES := -I$(NITROSDK)/libraries/gx/src

# Same source lists as NitroSystem's meson files, minus the FS archive wrapper
# (fnd/archive.c) and debug resource printing (g3d/binres/res_print*.c).
NNS_SRCS := \
	fnd/src/list.c fnd/src/heapcommon.c fnd/src/expheap.c fnd/src/frameheap.c \
	fnd/src/unitheap.c fnd/src/allocator.c \
	gfd/src/VramManager/gfd_TexVramMan.c gfd/src/VramManager/gfd_PlttVramMan.c \
	gfd/src/VramManager/gfd_FrameTexVramMan.c gfd/src/VramManager/gfd_FramePlttVramMan.c \
	gfd/src/VramTransferMan/gfd_VramTransferManager.c gfd/src/VramManager/gfdi_LinkedListVramMan_Common.c \
	gfd/src/VramManager/gfd_LinkedListTexVramMan.c gfd/src/VramManager/gfd_LinkedListPlttVramMan.c \
	g2d/src/load/g2d_NAN_load.c g2d/src/load/g2d_NOB_load.c g2d/src/load/g2d_NMC_load.c \
	g2d/src/load/g2d_NEN_load.c g2d/src/load/g2d_NCG_load.c g2d/src/load/g2d_NCL_load.c \
	g2d/src/load/g2d_NSC_load.c g2d/src/load/g2d_Load.c g2d/src/g2d_Softsprite.c \
	g2d/src/g2d_Animation.c g2d/src/g2d_OAM.c g2d/src/g2d_OAMEx.c g2d/src/g2d_PaletteTable.c \
	g2d/src/g2d_Image.c g2d/src/g2d_SRTControl.c g2d/src/g2d_Node.c g2d/src/g2d_CullingUtility.c \
	g2d/src/g2d_CellAnimation.c g2d/src/g2d_MultiCellAnimation.c g2d/src/g2d_Entity.c \
	g2d/src/g2d_Renderer.c g2d/src/internal/g2di_Mtx32.c g2d/src/internal/g2di_debug.c \
	g2d/src/g2d_CellTransferManager.c g2d/src/g2d_OamSoftwareSpriteDraw.c g2d/src/g2d_Screen.c \
	g2d/src/g2d_RendererCore.c g2d/src/g2d_Font.c g2d/src/g2d_CharCanvas.c g2d/src/g2d_TextCanvas.c \
	g2d/src/load/g2d_NFT_load.c g2d/src/internal/g2di_BitReader.c g2d/src/internal/g2di_SplitChar.c \
	g2d/src/internal/g2di_BGManipulator.c \
	g3d/src/kernel.c g3d/src/glbstate.c g3d/src/anm.c g3d/src/cgtool.c g3d/src/sbc.c \
	g3d/src/1mat1shp.c g3d/src/gecom.c g3d/src/util.c g3d/src/mem.c g3d/src/model.c \
	g3d/src/binres/res_struct.c g3d/src/binres/res_struct_accessor.c g3d/src/binres/res_struct_accessor_anm.c \
	g3d/src/anm/nsbca.c g3d/src/anm/nsbma.c g3d/src/anm/nsbta.c g3d/src/anm/nsbtp.c g3d/src/anm/nsbva.c \
	g3d/src/cgtool/basic.c g3d/src/cgtool/maya.c g3d/src/cgtool/si3d.c g3d/src/cgtool/3dsmax.c g3d/src/cgtool/xsi.c \
	snd/src/main.c snd/src/resource_mgr.c snd/src/waveout.c snd/src/player.c snd/src/stream.c snd/src/capture.c \
	snd/src/sndarc.c snd/src/heap.c snd/src/sndarc_loader.c snd/src/sndarc_player.c snd/src/sndarc_stream.c \
	snd/src/output_effect.c snd/src/seqdata.c snd/src/fader.c
NNS_CFLAGS := -Wno-c23-extensions -Wno-multichar -Wno-bitwise-op-parentheses -Wno-unsequenced -Wno-static-in-inline
NNS_PRIVATE_INCLUDES := -I$(NITROSYSTEM)/libraries/fnd/include -I$(NITROSYSTEM)/libraries/gfd/include \
	-I$(NITROSYSTEM)/libraries/g2d/include -I$(NITROSYSTEM)/libraries/g3d/src/binres

# Port replacements for decomp files that talk to hardware or unported systems
# (heap.c, game_overlay.c, boot.c), plus the platform layer.
PORT_SRCS := \
	platform/src/ntr_gx.c \
	platform/src/ntr_render.c \
	platform/src/ntr_sys.c \
	platform/src/ntr_sdk_asm.c \
	platform/src/ntr_g3.c \
	platform/src/ntr_raster.c \
	platform/src/ntr_texdecode.c \
	platform/src/ntr_os.c \
	platform/src/ntr_card.c \
	platform/src/ntr_tp.c \
	platform/src/ntr_crypto.c \
	platform/src/ntr_rtc.c \
	platform/src/ntr_wireless.c \
	platform/src/ntr_snd.c \
	platform/src/ntr_spu.c \
	game/port_boot.c \
	game/port_debug.c \
	game/port_heap.c \
	game/port_overlay.c \
	game/port_settings.c \
	$(BUILD)/generated/trainer_ai_script.c \
	$(wildcard game/stubs/*.c)

GEN_DIR := $(BUILD)/generated
SND7_OBJS := $(patsubst %.c,$(BUILD)/obj/sdk7/%.o,$(SND7_SRCS))
SND7_RAW_OBJS := $(patsubst %.c,$(BUILD)/obj/sdk7raw/%.o,$(SND7_SRCS))
GAMESRC_DIR := $(BUILD)/gamesrc
NNSSRC_DIR := $(BUILD)/nnssrc
SDKSRC_DIR := $(BUILD)/sdksrc
GEN_STAMP := $(GEN_DIR)/.stamp

GAME_COPIES := $(addprefix $(GAMESRC_DIR)/,$(GAME_SRCS))

# Like meson, every folder holding generated headers is on the include path
# (some sources include them by bare name, e.g. "ending.naix").
DECOMP_GEN_DIRS := $(addprefix -I,$(sort $(dir $(shell find $(DECOMP_GEN)/generated $(DECOMP_GEN)/res -name '*.naix' -o -name '*.h' 2>/dev/null | grep -v '\.p/'))))
# Nintendo Wi-Fi Connection headers: only their types are used; Wi-Fi itself is
# not ported (its functions are offline stubs).
WIFI_INCLUDES := $(addprefix -I,$(wildcard $(DECOMP)/subprojects/NitroDWC-*/include $(DECOMP)/subprojects/NitroDWC-*/include/gs \
	$(DECOMP)/subprojects/NitroDWC-*/include/base $(DECOMP)/subprojects/NitroWiFi-*/include $(DECOMP)/subprojects/libvct-*/include))
# Decomp headers with a patch in patches/ are copied, patched, and found first.
HEADER_PATCHES := $(shell find patches -name '*.h.patch' -not -path 'patches/nitro*' 2>/dev/null)
PATCHED_HEADERS := $(patsubst patches/%.patch,$(BUILD)/patched/%,$(HEADER_PATCHES))
PATCHED_INCLUDES := $(addprefix -I,$(sort $(dir $(PATCHED_HEADERS))))

INCLUDES := -Iplatform/include -Igame $(PATCHED_INCLUDES) -I$(GEN_DIR) -I$(GEN_DIR)/sdkfwd -I$(NITROSYSTEM)/include \
	-I$(DECOMP)/include -I$(DECOMP) -I$(DECOMP_GEN) $(DECOMP_GEN_DIRS) \
	-I$(DECOMP)/lib/spl/include -I$(DECOMP)/lib/gds/include -I$(DECOMP)/lib/crypto/include -I$(DECOMP)/lib/crypto/src \
	-I$(DECOMP)/lib/ppwlobby/include $(WIFI_INCLUDES)
SDK_DEFINES := -DSDK_ARM9 -DSDK_FINALROM -DSDK_TS -DSDK_4M -DSDK_CODE_ARM -DNNS_FINALROM -D_NITRO
PREFIX_HEADER := -include $(DECOMP)/include/pch/global_pch.h
# Same defines and char/enum/wchar_t semantics as the decomp's Metrowerks build (-char signed, -enum int,
# 16-bit wchar_t). The decomp also relies on type punning and wrapping signed arithmetic.
# PM_KEEP_ASSERTS keeps GF_ASSERT on.
COMMON_CFLAGS := -std=gnu11 -fno-strict-aliasing -fwrapv -fsigned-char -fno-short-enums -fshort-wchar -Wall -Wno-unknown-pragmas -Wno-switch -Wno-unused-variable -Wno-unused-function \
	-DPOKEPLATINUM_GENERATED_ENUM -DPOKEPLATINUM_REVISION=1 -DPM_KEEP_ASSERTS \
	-DGAME_VERSION=VERSION_PLATINUM -DGAME_LANGUAGE=LANGUAGE_ENGLISH $(SDK_DEFINES)

# Preprocessor used to extract SDK definitions (any GCC/Clang works).
CPP_FOR_GEN ?= clang

# The decomp was written for Metrowerks; these warnings are expected there.
# -fms-extensions: tagged anonymous struct members (e.g. Poffin), which Metrowerks
# accepts. Pointer/integer mixing is accepted as Metrowerks did, as a warning.
GAME_CFLAGS := -fms-extensions -Wno-error=implicit-int -Wno-implicit-int -Wno-error=int-conversion -Wno-int-conversion -Wno-error=incompatible-pointer-types \
	-Wno-incompatible-pointer-types -Wno-microsoft-anon-tag \
	-Wno-incompatible-pointer-types-discards-qualifiers -Wno-missing-braces -Wno-unused-but-set-variable \
	-Wno-c23-extensions -Wno-bitwise-op-parentheses -Wno-duplicate-decl-specifier -Wno-multichar \
	-Wno-implicitly-unsigned-literal -Wno-deprecated-non-prototype -Wno-void-pointer-to-int-cast

# Copy a decomp source and apply its patch from patches/ if there is one
# (the copy is redone when the patch changes).
.SECONDEXPANSION:
$(GAMESRC_DIR)/%.c: $(DECOMP)/src/%.c $$(wildcard patches/$$*.c.patch)
	@mkdir -p $(dir $@)
	cp $< $@
	@p=patches/$*.c.patch; if [ -f $$p ]; then patch -s $@ < $$p; fi

# Copy a decomp library source.
$(GAMESRC_DIR)/lib/%.c: $(DECOMP)/lib/%.c $$(wildcard patches/lib/$$*.c.patch)
	@mkdir -p $(dir $@)
	cp $< $@
	@p=patches/lib/$*.c.patch; if [ -f $$p ]; then patch -s $@ < $$p; fi

# Copy a NitroSDK source without its assembly routines.
$(SDKSRC_DIR)/%.c: $(NITROSDK)/libraries/%.c tools/strip_asm.py $$(wildcard patches/nitrosdk/$$(notdir $$*).c.patch)
	@mkdir -p $(dir $@)
	python3 -I tools/strip_asm.py $< $@
	@p=patches/nitrosdk/$(notdir $*).c.patch; if [ -f $$p ]; then patch -s $@ < $$p; fi

# Copy a NitroSystem source and apply its patch from patches/nitrosystem/.
$(NNSSRC_DIR)/%.c: $(NITROSYSTEM)/libraries/%.c $$(wildcard patches/nitrosystem/$$(notdir $$*).c.patch)
	@mkdir -p $(dir $@)
	cp $< $@
	@p=patches/nitrosystem/$(notdir $*).c.patch; if [ -f $$p ]; then patch -s $@ < $$p; fi
	@# NNS_*_INLINE already means "static inline" here; GCC rejects a second static.
	perl -pi -e 's/\bstatic\b(.*?\bNNS_[A-Z0-9]*_?INLINE\b)/$$1/g' $@

$(BUILD)/patched/%: $(DECOMP)/% patches/%.patch
	@mkdir -p $(dir $@)
	cp $< $@
	patch -s $@ < patches/$*.patch

# The trainer AI scripts (assembler data in the decomp), as a C array. Needs a
# host clang that can assemble ARM (any stock clang).
AS_FOR_GEN ?= clang
$(GEN_DIR)/trainer_ai_script.c: $(DECOMP)/src/battle/trainer_ai/script.s tools/gen_trainer_ai.py $(GEN_STAMP)
	python3 -I tools/gen_trainer_ai.py "$(AS_FOR_GEN)" $(DECOMP) $(DECOMP_GEN) $@

# All generated headers, made once before any compile.
$(GEN_STAMP): $(PATCHED_HEADERS) tools/gen_sdk_defs.py tools/gen_sdk_forwarders.py
	@test -f $(DECOMP_GEN)/generated/species.h || (echo "decomp headers missing: run tools/setup_decomp_gen.sh" && false)
	python3 -I tools/gen_sdk_defs.py "$(CPP_FOR_GEN)" $(NITROSDK) $(GEN_DIR)/ntr_sdk_defs.h $(GEN_DIR)/ntr_sdk_inlines.h \
		$(GEN_DIR)/ntr_sdk_defs7.h
	python3 -I tools/gen_sdk_forwarders.py $(NITROSDK) $(GEN_DIR)/sdkfwd
	@touch $@

# The ARM7 sound driver (SND7_SRCS). Its ARM7 view of the SDK sound headers
# comes from the same extraction as the ARM9 one; then every symbol it
# defines gets an ARM7_ prefix, listed from a first compile (nm), so the two
# halves of the shared sources link side by side.
SND7_CFLAGS = $(CFLAGS) $(GAME_CFLAGS) -DNTR_SND7 -include platform/include/ntr_snd7.h
$(BUILD)/obj/sdk7raw/%.o: $(SDKSRC_DIR)/%.c $(GEN_STAMP)
	@mkdir -p $(dir $@)
	$(CC) $(SND7_CFLAGS) -DNTR_SND7_RAW -c -o $@ $<

$(GEN_DIR)/ntr_snd7_names.h: $(SND7_RAW_OBJS) tools/gen_snd7_names.py
	$(NM) -g -P $(SND7_RAW_OBJS) | python3 -I tools/gen_snd7_names.py > $@

$(BUILD)/obj/sdk7/%.o: $(SDKSRC_DIR)/%.c $(GEN_DIR)/ntr_snd7_names.h
	@mkdir -p $(dir $@)
	$(CC) $(SND7_CFLAGS) -c -o $@ $<
